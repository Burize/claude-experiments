cabal-version:      2.4
name:               haskell-rest-api
version:            0.1.0.0
synopsis:           A simple REST API example in Haskell
description:        Learn Haskell by building a simple REST API with Scotty
license:            MIT
author:             Claude
maintainer:         example@example.com
category:           Web
extra-source-files: README.md

library
    exposed-modules:  Main
    hs-source-dirs:   app
    build-depends:    base >=4.17 && <5
                    , scotty
                    , aeson
                    , text
                    , random
                    , wai
                    , warp
                    , http-types
                    , persistent
                    , persistent-postgresql
                    , persistent-template
                    , monad-logger
                    , transformers
                    , resourcet
                    , bytestring
                    , cryptonite
                    , memory
    default-language: Haskell2010
    ghc-options:      -Wall

executable haskell-rest-api
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.17 && <5
                    , haskell-rest-api
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite haskell-rest-api-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >=4.17 && <5
                    , haskell-rest-api
                    , hspec
                    , hspec-wai
                    , hspec-wai-json
                    , aeson
                    , text
                    , bytestring
                    , http-client
                    , http-client-tls
                    , http-types
                    , wai
                    , scotty
                    , persistent
                    , persistent-postgresql
                    , monad-logger
                    , transformers
                    , resourcet
                    , async
    other-modules:    UserSignupSpec
                    , UserSigninSpec
                    , UserMeSpec
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N -Wall
